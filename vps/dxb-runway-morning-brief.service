[Unit]
Description=DXB Runway 07:00 Dubai sales briefing notification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dxbpipeline
Group=dxbpipeline
EnvironmentFile=/etc/dxb-runway/pipeline.env
ExecStart=/opt/dxb-runway-pipeline/venv/bin/python /opt/dxb-runway-pipeline/pipeline_brief.py --notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dxb-runway-pipeline

