[Unit]
Description=Publish cached DXB Runway brief to mobile
After=network-online.target dxb-runway-pipeline-sync.service
Wants=network-online.target

[Service]
Type=oneshot
User=runway-publisher
Group=runway-publisher
EnvironmentFile=/etc/dxb-runway/publisher.env
ExecStart=/opt/dxb-runway-pipeline/venv/bin/python /opt/dxb-runway-pipeline/pipeline_brief.py --publish-only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/dxb-runway-pipeline
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
