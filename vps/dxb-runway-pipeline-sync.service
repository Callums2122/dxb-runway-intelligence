[Unit]
Description=DXB Runway read-only Pipeline cache and mobile brief sync
After=network-online.target
Wants=network-online.target
OnSuccess=dxb-runway-mobile-publish.service

[Service]
Type=oneshot
User=runway-reader
Group=runway-reader
EnvironmentFile=/etc/dxb-runway/reader.env
ExecStart=/opt/dxb-runway-pipeline/venv/bin/python /opt/dxb-runway-pipeline/pipeline_brief.py --fetch-only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dxb-runway-pipeline /var/lib/dxb-runway-agent
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
